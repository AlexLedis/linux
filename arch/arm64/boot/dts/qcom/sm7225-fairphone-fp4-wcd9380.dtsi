};

&soc {
   swr0:soundwire@3210000 {
      compatible = "qcom,soundwire-v1.6.0";
      reg = < 0x0 0x3210000 0x0 0x2000 >;
      interrupts = <GIC_SPI 297 IRQ_TYPE_LEVEL_HIGH>; // From Android 15, lagoon-audio-overlay.dtsi
      interrupt-names = "swr_master_irq"; // From Android 15, lagoon-audio-overlay.dtsi

       "gpio14";
      function = "swr_tx_data";
      drive-strength = < 0x2 >;
      slew-rate = < 0x1 >;
      bias-bus-hold;
      phandle = < 0xf0 >;
   };
};

&soc {
   lpass_va_macro:codec@3370000 {
      compatible = "qcom,sm8250-lpass-va-macro";
      reg = < 0x0 0x3370000 0x0 0x1000 >;
      clocks = < &q6afecc 0x39 0x1 >,
         < &q6afecc 0x66 0x1 >,
         < &q6afecc 0x67 0x1 >;
      clock-names = "mclk",
              "macro",
              "dcodec";
      clock-output-names = "fsgen";
      #clock-cells = < 0x0 >;
      #sound-dai-cells = < 0x1 >;
      vdd-micb-supply = < &vreg_bob >;
      qcom,dmic-sample-rate = < 0x493e00 >;
      status = "okay";
      phandle = < 0xec >;
   };
};

&tlmm {
   wcd_reset_n:wcd-reset-n-state {
      pins = "gpio83";

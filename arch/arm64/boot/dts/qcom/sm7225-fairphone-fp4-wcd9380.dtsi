      qcom,ports-hstop = [ FF 06 FF FF FF FF FF FF ];
      qcom,ports-block-group-count = [ FF FF FF FF 00 FF FF FF ];
      #sound-dai-cells = < 0x1 >;
      #address-cells = < 0x2 >;
